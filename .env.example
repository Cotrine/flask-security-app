# ==========================================================
# Variables de Entorno OBLIGATORIAS para Seguridad Informática
# ==========================================================

# Clave secreta para firmar sesiones y tokens CSRF (genera una cadena aleatoria y segura)
SECRET_KEY=clave_secreta_super_segura_para_desarrollo_local_2026

# Conexión directa a PostgreSQL (Formato estándar: postgresql://usuario:password@host:puerto/nombre_bd)
# Ejemplo local:
DATABASE_URL=postgresql://seguridad_user:seguridad_pass@localhost:5432/seguridad_db
# Ejemplo AWS RDS (para cuando despliegues en la Parte C):
# DATABASE_URL=postgresql://usuario_rds:password_rds@midb-proyecto.xxxxx.us-east-1.rds.amazonaws.com:5432/proyecto_db
